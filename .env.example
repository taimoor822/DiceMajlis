DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=true
DJANGO_LOG_LEVEL=INFO

# Redis (Channels)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Database (choose one)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dice_majlis
# DATABASE_URL=sqlite:///absolute/path/to/db.sqlite3
DB_ENGINE=sqlite
DB_NAME=dice_majlis
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
