# Development defaults. With DJANGO_DEBUG=false the server refuses to start unless
# DJANGO_SECRET_KEY is a real secret and DJANGO_ALLOWED_HOSTS lists your domain(s).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
# "*" lets a phone on your Wi-Fi reach the dev server; use real domains in production.
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=true
DJANGO_LOG_LEVEL=INFO

# Real-time messaging: "memory" = no Redis needed (ONE server process, development only)
#                      "redis"  = production / several processes (docker compose up -d redis)
CHANNEL_LAYER=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Database (choose one)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dice_majlis
# DATABASE_URL=sqlite:////absolute/path/to/db.sqlite3   (4 slashes = absolute path)
DB_ENGINE=sqlite
DB_NAME=dice_majlis
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Turn timer (auto-plays idle players). Runs inside the server process by default.
# For a separate worker: set GAME_TIMER_IN_PROCESS=false and run
#   python manage.py run_turn_timers
GAME_TIMER_IN_PROCESS=true
GAME_TIMER_INTERVAL_SECONDS=1

# Accounts (step 1.6). Access tokens are signed with JWT_SIGNING_KEY; when it's empty
# a key is derived from DJANGO_SECRET_KEY. In production you may set your own (32+
# random characters, kept secret). Changing it only ends current 15-minute access
# tokens; the app refreshes them on its own.
# JWT_SIGNING_KEY=
# AUTH_ACCESS_MINUTES=15
# AUTH_REFRESH_DAYS=30
# Rate limits per IP, e.g. "20/hour". Behind a proxy/load balancer set
# DJANGO_NUM_PROXIES to the number of proxies so the real client IP is used.
# AUTH_GUEST_SIGNUP_RATE=20/hour
# AUTH_REFRESH_RATE=240/hour
# DJANGO_NUM_PROXIES=0
